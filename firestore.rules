rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Common Security Helper Functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'daovanloi.tankhanhtrung3@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isOwner(authorId) {
      return isSignedIn() && request.auth.uid == authorId;
    }

    // Entity Validation: EducationalApp
    function isValidApp(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 100 &&
             data.description is string && data.description.size() > 0 && data.description.size() <= 1000 &&
             data.category is string && data.category.size() <= 50 &&
             data.authorId is string && data.authorId.size() <= 128 &&
             (!('url' in data) || (data.url is string && data.url.size() <= 500)) &&
             (!('guideTips' in data) || (data.guideTips is string && data.guideTips.size() <= 1000)) &&
             (!('categoryLabel' in data) || (data.categoryLabel is string && data.categoryLabel.size() <= 100)) &&
             (!('gradeLevel' in data) || (data.gradeLevel is string && data.gradeLevel.size() <= 50)) &&
             (!('gradeLabel' in data) || (data.gradeLabel is string && data.gradeLabel.size() <= 50)) &&
             (!('developer' in data) || (data.developer is string && data.developer.size() <= 100)) &&
             (!('tags' in data) || (data.tags is string && data.tags.size() <= 300)) &&
             (!('authorEmail' in data) || (data.authorEmail is string && data.authorEmail.size() <= 150)) &&
             (!('authorName' in data) || (data.authorName is string && data.authorName.size() <= 100)) &&
             (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 500));
    }

    // Entity Validation: InteractiveGame
    function isValidGame(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 100 &&
             data.subject is string && data.subject.size() <= 50 &&
             data.description is string && data.description.size() > 0 && data.description.size() <= 1000 &&
             data.authorId is string && data.authorId.size() <= 128 &&
             (!('gameType' in data) || (data.gameType is string && data.gameType.size() <= 50)) &&
             (!('gameTypeLabel' in data) || (data.gameTypeLabel is string && data.gameTypeLabel.size() <= 100)) &&
             (!('subjectLabel' in data) || (data.subjectLabel is string && data.subjectLabel.size() <= 100)) &&
             (!('grade' in data) || (data.grade is string && data.grade.size() <= 50)) &&
             (!('gradeLabel' in data) || (data.gradeLabel is string && data.gradeLabel.size() <= 50)) &&
             (!('playMode' in data) || (data.playMode is string && data.playMode.size() <= 30)) &&
             (!('externalUrl' in data) || (data.externalUrl is string && data.externalUrl.size() <= 500)) &&
             (!('targetSkills' in data) || (data.targetSkills is string && data.targetSkills.size() <= 300)) &&
             (!('authorEmail' in data) || (data.authorEmail is string && data.authorEmail.size() <= 150)) &&
             (!('authorName' in data) || (data.authorName is string && data.authorName.size() <= 100)) &&
             (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 500));
    }

    // Entity Validation: ScienceExperiment
    function isValidExperiment(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 100 &&
             data.subject is string && data.subject.size() <= 50 &&
             data.description is string && data.description.size() > 0 && data.description.size() <= 1000 &&
             data.authorId is string && data.authorId.size() <= 128 &&
             (!('topic' in data) || (data.topic is string && data.topic.size() <= 50)) &&
             (!('topicLabel' in data) || (data.topicLabel is string && data.topicLabel.size() <= 100)) &&
             (!('subjectLabel' in data) || (data.subjectLabel is string && data.subjectLabel.size() <= 100)) &&
             (!('grade' in data) || (data.grade is string && data.grade.size() <= 50)) &&
             (!('simMode' in data) || (data.simMode is string && data.simMode.size() <= 50)) &&
             (!('externalUrl' in data) || (data.externalUrl is string && data.externalUrl.size() <= 500)) &&
             (!('learningGoals' in data) || (data.learningGoals is string && data.learningGoals.size() <= 500)) &&
             (!('authorEmail' in data) || (data.authorEmail is string && data.authorEmail.size() <= 150)) &&
             (!('authorName' in data) || (data.authorName is string && data.authorName.size() <= 100)) &&
             (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 500));
    }

    // Entity Validation: UserProfile
    function isValidUserProfile(data) {
      return data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 150 &&
             (!('school' in data) || (data.school is string && data.school.size() <= 150)) &&
             (!('role' in data) || (data.role is string && data.role.size() <= 50));
    }

    // COLLECTION: Apps
    match /apps/{appId} {
      allow read: if true; // Public repository for teachers & pupils

      allow create: if isSignedIn() &&
                       isValidId(appId) &&
                       isValidApp(incoming()) &&
                       incoming().authorId == request.auth.uid;

      allow update: if isSignedIn() &&
                       isValidId(appId) &&
                       isValidApp(incoming()) &&
                       incoming().authorId == existing().authorId &&
                       (isOwner(existing().authorId) || isAdmin());

      allow delete: if isSignedIn() &&
                       isValidId(appId) &&
                       (isOwner(existing().authorId) || isAdmin());
    }

    // COLLECTION: Games
    match /games/{gameId} {
      allow read: if true;

      allow create: if isSignedIn() &&
                       isValidId(gameId) &&
                       isValidGame(incoming()) &&
                       incoming().authorId == request.auth.uid;

      allow update: if isSignedIn() &&
                       isValidId(gameId) &&
                       isValidGame(incoming()) &&
                       incoming().authorId == existing().authorId &&
                       (isOwner(existing().authorId) || isAdmin());

      allow delete: if isSignedIn() &&
                       isValidId(gameId) &&
                       (isOwner(existing().authorId) || isAdmin());
    }

    // COLLECTION: Simulations
    match /simulations/{simId} {
      allow read: if true;

      allow create: if isSignedIn() &&
                       isValidId(simId) &&
                       isValidExperiment(incoming()) &&
                       incoming().authorId == request.auth.uid;

      allow update: if isSignedIn() &&
                       isValidId(simId) &&
                       isValidExperiment(incoming()) &&
                       incoming().authorId == existing().authorId &&
                       (isOwner(existing().authorId) || isAdmin());

      allow delete: if isSignedIn() &&
                       isValidId(simId) &&
                       (isOwner(existing().authorId) || isAdmin());
    }

    // COLLECTION: User Profiles
    match /users/{userId} {
      allow read: if true;

      allow create, update: if isSignedIn() &&
                               isValidId(userId) &&
                               request.auth.uid == userId &&
                               isValidUserProfile(incoming());

      allow delete: if isSignedIn() &&
                       isValidId(userId) &&
                       (request.auth.uid == userId || isAdmin());
    }

    // Test connection probe
    match /test/connection {
      allow read: if true;
    }
  }
}
